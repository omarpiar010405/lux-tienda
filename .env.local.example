# Supabase > Project Settings > API (usa la clave pública "anon" o "publishable"; NUNCA la service_role)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-o-publishable

# --- Marca y contacto (todos opcionales) ---
NEXT_PUBLIC_NOMBRE_TIENDA=LUX
# WhatsApp de la boutique con lada de país, solo números. Ej. 5215512345678
NEXT_PUBLIC_WHATSAPP_NUMERO=
NEXT_PUBLIC_INSTAGRAM_URL=
# Barra dorada sobre el encabezado (déjala vacía para ocultarla). Ej. Envíos a todo México
NEXT_PUBLIC_ANUNCIO=
# Dirección de la tienda (para "recoger en tienda" y el pie de página)
NEXT_PUBLIC_DIRECCION_TIENDA=
# Horario de recolección en tienda (texto libre). Si va vacío: "De lunes a viernes, de 9:00 a 16:00 h."
NEXT_PUBLIC_HORARIO_TIENDA=
# Datos para la transferencia (banco, CLABE, titular). Lo ve la clienta al elegir transferencia y en su pedido.
# Puedes usar \n para saltos de línea. Ej. Banco X\nCLABE 000000000000000000\nTitular: LUX
NEXT_PUBLIC_INSTRUCCIONES_PAGO=

# Caja registradora: déjala en false para vender sin abrir caja (modo actual). Pon true para volver a exigirla.
NEXT_PUBLIC_USAR_CAJA=false

# --- Aviso de privacidad (datos del responsable; ver /privacidad) ---
NEXT_PUBLIC_RESPONSABLE_PRIVACIDAD=
NEXT_PUBLIC_DOMICILIO_PRIVACIDAD=
NEXT_PUBLIC_CORREO_PRIVACIDAD=
